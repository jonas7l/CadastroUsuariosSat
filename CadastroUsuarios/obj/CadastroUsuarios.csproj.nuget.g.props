    <PkgNUnit_Extension_NUnitV2Driver Condition=" '$(PkgNUnit_Extension_NUnitV2Driver)' == '' ">C:\Users\Jonas\.nuget\packages\nunit.extension.nunitv2driver\3.9.0</PkgNUnit_Extension_NUnitV2Driver>
